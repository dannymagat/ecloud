{
  "name": "ecloud",
  "version": "0.1.0",
  "private": true,
  "description": "ECLOUD cloud bandwidth management platform - npm workspaces monorepo",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "ECLOUD_TEST_REQUIRE_INTEGRATION=1 vitest run",
    "test:isolation": "ECLOUD_TEST_REQUIRE_INTEGRATION=1 vitest run --project tests tests/isolation tests/security",
    "test:aaa-contract": "ECLOUD_TEST_RADIUS=1 vitest run --project tests tests/aaa-contract",
    "dev:stack": "docker compose --project-directory . -f infra/compose/docker-compose.dev.yml up -d --wait",
    "dev:stack:down": "docker compose --project-directory . -f infra/compose/docker-compose.dev.yml down",
    "dev:stack:reset": "docker compose --project-directory . -f infra/compose/docker-compose.dev.yml down -v",
    "db:migrate": "npm run migrate --workspace @ecloud/db --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
