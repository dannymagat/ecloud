# sops configuration TEMPLATE for the private ops repository (P10-A, SECURITY_ARCHITECTURE.md §9).
# Copy to `.sops.yaml` in the ops repository (NOT this repository) and replace the recipients
# with the real age PUBLIC keys: one per operator (hardware token / offline) + one recovery key.
# Public keys are not secret, but the placeholders below are deliberately invalid.
creation_rules:
  - path_regex: secrets/[a-z0-9-]+\.enc\.yaml$
    age: >-
      age1PLACEHOLDER0OPERATOR0PUBLIC0KEY,
      age1PLACEHOLDER0RECOVERY0PUBLIC0KEY
