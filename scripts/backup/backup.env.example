# EXAMPLE ONLY - environment for scripts/backup/backup.sh (copy to /opt/ecloud/secrets/backup.env,
# mode 0600, and pass with --env-file). No secrets belong in this file in git (D-033).
BACKUP_DIR=/var/backups/ecloud
BACKUP_AGE_RECIPIENTS_FILE=/opt/ecloud/secrets/backup-recipients.txt
BACKUP_RETENTION_COUNT=7
# Pilot layout: dump inside the postgres container (role needs only pg_read_all_data).
BACKUP_PG_CONTAINER=ecloud-postgres
BACKUP_PG_USER=ecloud_backup
BACKUP_PG_DATABASE=ecloud
BACKUP_CONFIG_PATHS="/opt/ecloud/compose.yaml /opt/ecloud/compose.pilot.yaml /opt/ecloud/config /etc/caddy /etc/nftables.conf /etc/docker/daemon.json"
# D-026: never only on the VPS. Off-site target is REQUIRES CLARIFICATION (Q18).
BACKUP_UPLOAD=rclone
# rclone remote configured in /root/.config/rclone/rclone.conf (0600) - S3-compatible bucket.
BACKUP_RCLONE_REMOTE=offsite:ecloud-backups/pilot
# Optional uptime-kuma push monitor (alert when no push for 26 h).
BACKUP_PUSH_URL=
BACKUP_TEXTFILE_DIR=/var/lib/node_exporter/textfile
