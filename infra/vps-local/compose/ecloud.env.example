# EXAMPLE -> /opt/ecloud/ecloud.env (root:root 0644). NO SECRETS in this file (they are files in
# /opt/ecloud/secrets). Read by /opt/ecloud/bin/ecloud-compose via --env-file.
ECLOUD_ROOT=/opt/ecloud
# Release id (git commit) of the images loaded on the host.
IMAGE_TAG=1f1e1bc
# Image names; the images are loaded with `docker load` until GHCR push exists (D-024).
ECLOUD_REGISTRY=ghcr.io/dannymagat
# LAN address of bond1 (DHCP today: needs a reservation, LCL-PRE-7).
ECLOUD_LAN_IP=192.168.203.196
ECLOUD_SECRETS_DIR=/opt/ecloud/secrets
ECLOUD_TLS_DIR=/opt/ecloud/tls

# Address the web ports 443 (admin/API) and 444 (portal) are published on (default all addresses;
# the firewall still admits only ECLOUD_WEB_CIDRS).
ECLOUD_WEB_BIND=0.0.0.0

# Public-facing origins the browser uses to reach the admin SPA and captive portal.
# These MUST match the URL in the browser's address bar exactly (scheme + host + port).
# Cloudflare-tunnel example (ezecloud.ezelink.ai):
#   PUBLIC_ADMIN_ORIGIN=https://ezecloud.ezelink.ai
#   PUBLIC_API_ORIGIN=https://ezecloud.ezelink.ai
#   PUBLIC_PORTAL_ORIGIN=https://ezecloud.ezelink.ai:444
# LAN-only example:
#   PUBLIC_ADMIN_ORIGIN=https://192.168.203.196
#   PUBLIC_API_ORIGIN=https://192.168.203.196
#   PUBLIC_PORTAL_ORIGIN=https://192.168.203.196:444
PUBLIC_ADMIN_ORIGIN=https://ezecloud.ezelink.ai
PUBLIC_API_ORIGIN=https://ezecloud.ezelink.ai
PUBLIC_PORTAL_ORIGIN=https://ezecloud.ezelink.ai:444
