# EXAMPLE -> /opt/ecloud/ecloud.env (root:root 0644). NO SECRETS in this file (they are files in
# /opt/ecloud/secrets). Read by /opt/ecloud/bin/ecloud-compose via --env-file.
ECLOUD_ROOT=/opt/ecloud
# Release id (git commit) of the images loaded on the host: the rebuild after the F-P10-07 fix.
IMAGE_TAG=REQUIRES_CLARIFICATION
# Image names; the images are loaded with `docker load` until GHCR push exists (D-024).
ECLOUD_REGISTRY=ghcr.io/dannymagat
# LAN address of bond1 (DHCP today: needs a reservation, LCL-PRE-7).
ECLOUD_LAN_IP=192.168.203.196
ECLOUD_SECRETS_DIR=/opt/ecloud/secrets
ECLOUD_TLS_DIR=/opt/ecloud/tls
