# EXAMPLE -> /opt/ecloud/ecloud.env (root:root 0644). NO SECRETS in this file (they are files in
# /opt/ecloud/secrets). Read by /opt/ecloud/bin/ecloud-compose via --env-file.
ECLOUD_ROOT=/opt/ecloud
# Release id (git commit) of the images loaded on the host.
IMAGE_TAG=1f1e1bc
# Image names; the images are loaded with `docker load` until GHCR push exists (D-024).
ECLOUD_REGISTRY=ghcr.io/dannymagat
# LAN address of bond1 (DHCP today: needs a reservation, LCL-PRE-7).
ECLOUD_LAN_IP=192.168.203.196
ECLOUD_SECRETS_DIR=/opt/ecloud/secrets
ECLOUD_TLS_DIR=/opt/ecloud/tls

# Address the web ports 443 (admin/API) and 444 (portal) are published on (default all addresses;
# the firewall still admits only ECLOUD_WEB_CIDRS).
ECLOUD_WEB_BIND=0.0.0.0

# Public-facing origins the browser uses to reach the admin SPA and captive portal.
# These MUST match the URL in the browser's address bar exactly (scheme + host + port).
# Cloudflare-tunnel example (ezecloud.ezelink.ai):
#   PUBLIC_ADMIN_ORIGIN=https://ezecloud.ezelink.ai
#   PUBLIC_API_ORIGIN=https://ezecloud.ezelink.ai
#   PUBLIC_PORTAL_ORIGIN=https://ezecloud.ezelink.ai:444
# LAN-only example:
#   PUBLIC_ADMIN_ORIGIN=https://192.168.203.196
#   PUBLIC_API_ORIGIN=https://192.168.203.196
#   PUBLIC_PORTAL_ORIGIN=https://192.168.203.196:444
PUBLIC_ADMIN_ORIGIN=https://ezecloud.ezelink.ai
PUBLIC_API_ORIGIN=https://ezecloud.ezelink.ai
PUBLIC_PORTAL_ORIGIN=https://ezecloud.ezelink.ai:444

# --- FreeRADIUS -> api credential transport (HERMES_AAA_AUDIT.md F-002) ----------------------
# rlm_rest POSTs the whole RADIUS request to the api internal listener, User-Password included.
# Default: cleartext over this host's private compose network, which is not published.
# The acknowledgement is explicit on purpose -- freeradius refuses to start in a production
# deployment (RADIUS_CLIENTS_RENDERED=1) with a cleartext URL and no acknowledgement, so the
# risk can never be accepted silently.
#ECLOUD_INTERNAL_CLEARTEXT_ACK=1
#
# To switch the leg to TLS (owner-approved change; needs a certificate first):
#   1. Issue a leaf for the api service name with the internal CA:
#        sudo ECLOUD_APPROVED_CHANGE=LCL-TLS-1 ./make-lan-tls.sh ca      # once
#        (then issue a leaf whose SAN covers the name in ECLOUD_INTERNAL_URL, e.g. DNS:api)
#   2. Point the api at the leaf and the key (paths inside the container; ECLOUD_TLS_DIR is
#      mounted read-only at /etc/ecloud/tls):
#        INTERNAL_TLS_CERT_FILE=/etc/ecloud/tls/api-internal.crt
#        INTERNAL_TLS_KEY_FILE=/etc/ecloud/tls/api-internal.key
#   3. Point FreeRADIUS at https and pin the CA, then drop the acknowledgement:
#        ECLOUD_INTERNAL_URL=https://api:3001
#        RADIUS_INTERNAL_CA_FILE=/etc/ecloud/tls/ca/ca.crt
#        ECLOUD_INTERNAL_CLEARTEXT_ACK=
# Setting one of INTERNAL_TLS_CERT_FILE / INTERNAL_TLS_KEY_FILE without the other makes the api
# refuse to boot rather than fall back to cleartext.
#ECLOUD_TLS_DIR=/opt/ecloud/tls
