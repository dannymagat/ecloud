# EXAMPLE ONLY -> /opt/ecloud/secrets/backup.env (root:root 0600). vps-local variant of
# scripts/backup/backup.env.example. No secrets belong in this file in git (D-033).
BACKUP_DIR=/data/ecloud-backups
# age PUBLIC key(s) only; the private key stays with the operator, never on this host.
BACKUP_AGE_RECIPIENTS_FILE=/opt/ecloud/secrets/backup-recipients.txt
BACKUP_RETENTION_COUNT=7
BACKUP_PG_CONTAINER=ecloud-postgres
BACKUP_PG_USER=ecloud_backup
BACKUP_PG_DATABASE=ecloud
# The internal CA private key (/opt/ecloud/tls/ca) is deliberately NOT included: the owner keeps
# one offline copy (LCL-TLS-1). Edge cert/key and the public CA cert are included.
BACKUP_CONFIG_PATHS="/opt/ecloud/ecloud.env /opt/ecloud/infra/vps-local /opt/ecloud/tls/edge.crt /opt/ecloud/tls/edge.key /opt/ecloud/tls/ecloud-lan-ca.crt /etc/ecloud /etc/docker/daemon.json"
# D-026 off-host copy: orphan branch `vps-local` of github.com/dannymagat/ecloud (owner 2026-10-09);
# settings in /etc/ecloud/backup-github.env (infra/vps-local/backup/backup-github.env.example).
BACKUP_UPLOAD=command
BACKUP_UPLOAD_COMMAND=/opt/ecloud/bin/upload-github.sh
AGE_BIN=/usr/local/bin/age
BACKUP_PUSH_URL=
