# EXAMPLE -> /etc/ecloud/backup-github.env (root:root 0600). No secrets (the deploy key is a
# separate file). Read by /opt/ecloud/bin/upload-github.sh.
BACKUP_GITHUB_REPO=dannymagat/ecloud
BACKUP_GITHUB_BRANCH=vps-local
BACKUP_GITHUB_KEY=/root/.ssh/ecloud-backup-deploy
BACKUP_GITHUB_KNOWN_HOSTS=/etc/ecloud/github_known_hosts
# Sets kept on the branch (each push replaces the branch with one orphan commit of these).
BACKUP_GITHUB_KEEP=7
BACKUP_GITHUB_SPLIT_MB=95
