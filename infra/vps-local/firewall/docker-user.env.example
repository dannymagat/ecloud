# EXAMPLE -> /etc/ecloud/docker-user.env (root:root 0644, host-local; written by
# apply-firewall.sh config). Owner values 2026-10-09; if hotspot clients sit on a subnet behind
# the AP (not 192.168.203.0/24) add it to ECLOUD_WEB_CIDRS (REQUIRES_CLARIFICATION). Never 0/0 or WAN.
ECLOUD_LAN_IP=192.168.203.196
# Who may open the admin UI (8443) and the captive portal (8444).
ECLOUD_WEB_CIDRS="192.168.203.0/24"
# Which NAS / access points may send RADIUS (1812/1813 udp): the single lab AP (owner 2026-10-09).
ECLOUD_RADIUS_CIDRS="192.168.203.198/32"
