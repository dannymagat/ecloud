# -*- text -*-
######################################################################
#
#  ECLOUD policies (AAA_ARCHITECTURE.md §2.1, §4.1, §5.2).
#  The stock policies this server relies on are unchanged and shipped by
#  the image: filter_username (policy.d/filter), rewrite_calling_station_id /
#  rewrite_called_station_id (policy.d/canonicalization), acct_unique /
#  insert_acct_class (policy.d/accounting).
#
######################################################################

#
#  Server-side facts ECLOUD needs for tenant/NAS resolution (AAA §3, §4.1):
#  the UDP source address is the PRIMARY client identity; NAS-IP-Address is
#  only an attribute the NAS fills in. rlm_rest `body = json` serialises the
#  request list, and the Packet-* attributes are virtual (not in that list),
#  so they are copied into ECLOUD-* internal attributes (dictionary.ecloud).
#
ecloud_request_context {
	update request {
		&ECLOUD-Packet-Src-IP-Address := "%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}"
		&ECLOUD-Packet-Src-Port := "%{Packet-Src-Port}"
		&ECLOUD-Packet-Dst-Port := "%{Packet-Dst-Port}"
		&ECLOUD-Client-Shortname := "%{client:shortname}"
	}
}

#
#  Authentication of FreeRADIUS towards ECLOUD: shared service token in an
#  HTTP header (DEPLOYMENT_ARCHITECTURE.md §4.2; mods-available/rest).
#  control:REST-HTTP-Header attributes are consumed by the next rlm_rest
#  call, so this policy runs before EVERY rest call.
#
#  $ENV{INTERNAL_API_TOKEN} is substituted when the configuration is read.
#  The string is still an xlat at run time, so the token must not contain
#  '%', '"' or '\' (documented in infra/freeradius/README.md).
#
ecloud_rest_headers {
	update control {
		&REST-HTTP-Header += "X-Internal-Token: $ENV{INTERNAL_API_TOKEN}"
		&REST-HTTP-Header += "Accept: application/json"
	}
}

#
#  Post-auth: strip credentials from the request list before it is posted to
#  /internal/aaa/post-auth and carry the outcome over (reply attributes are
#  not serialised by rlm_rest, so Class/Reply-Message are copied as strings).
#
ecloud_post_auth_context {
	update request {
		&ECLOUD-Decision := "%{control:ECLOUD-Decision}"
		&User-Password !* ANY
		&CHAP-Password !* ANY
		&CHAP-Challenge !* ANY
		&MS-CHAP-Response !* ANY
		&MS-CHAP2-Response !* ANY
		&MS-CHAP-Challenge !* ANY
	}
	if (&reply:Class) {
		update request {
			&ECLOUD-Reply-Class := "%{reply:Class}"
		}
	}
	if (&reply:Reply-Message) {
		update request {
			&ECLOUD-Reply-Message := "%{reply:Reply-Message}"
		}
	}
}
