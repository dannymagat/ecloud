# -*- text -*-
######################################################################
#
#  EZECLOUD policies (AAA_ARCHITECTURE.md §2.1, §4.1, §5.2).
#  The stock policies this server relies on are unchanged and shipped by
#  the image: filter_username (policy.d/filter), rewrite_calling_station_id /
#  rewrite_called_station_id (policy.d/canonicalization), acct_unique /
#  insert_acct_class (policy.d/accounting).
#
######################################################################

#
#  Server-side facts EZECLOUD needs for tenant/NAS resolution (AAA §3, §4.1):
#  the UDP source address is the PRIMARY client identity; NAS-IP-Address is
#  only an attribute the NAS fills in. rlm_rest `body = json` serialises the
#  request list, and the Packet-* attributes are virtual (not in that list),
#  so they are copied into ECLOUD-* internal attributes (dictionary.ecloud).
#
ecloud_request_context {
	update request {
		&ECLOUD-EAP-Inner !* ANY
		&ECLOUD-Outer-User-Name !* ANY
		&ECLOUD-Packet-Src-IP-Address := "%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}"
		&ECLOUD-Packet-Src-Port := "%{Packet-Src-Port}"
		&ECLOUD-Packet-Dst-Port := "%{Packet-Dst-Port}"
		&ECLOUD-Client-Shortname := "%{client:shortname}"
	}

	ecloud_tls_identity
}

#
#  RadSec (RFC 6614, migration 034; sites-available/ecloud-radsec). On the TLS
#  listener the client certificate has already been verified against the
#  EZECLOUD RadSec CA, so its CN (= nas_clients.id) and serial are
#  server-verified facts and are the NAS identity.
#
#  The certificate is read from the CONNECTION (%{listen:TLS-Client-Cert-*},
#  the mechanism the image's stock sites-available/tls documents): FreeRADIUS
#  3.2 does not copy it onto each packet's request, so a plain
#  %{TLS-Client-Cert-Common-Name} expands to nothing here (verified on this
#  image with a live RadSec connection). Reading the listener also keeps an
#  EAP-TLS supplicant certificate, which is not the NAS, out of it.
#
#  Keyed on the matched client: only the `ecloud-radsec` client of the TLS
#  listener's own client list sets the attributes; every other request has
#  them deleted. The CN is set even when empty, which the API and the drainer
#  treat as a refusal (a RadSec request never falls back to its NAT address).
#
#  Called from authorize (via ecloud_request_context) and preacct, because
#  accounting goes to rlm_sql (queries.conf) without the authorize context.
#
ecloud_tls_identity {
	update request {
		&ECLOUD-TLS-Client-Cert-CN !* ANY
		&ECLOUD-TLS-Client-Cert-Serial !* ANY
	}
	if ("%{client:shortname}" == "ecloud-radsec") {
		update request {
			&ECLOUD-TLS-Client-Cert-CN := "%{listen:TLS-Client-Cert-Common-Name}"
			&ECLOUD-TLS-Client-Cert-Serial := "%{listen:TLS-Client-Cert-Serial}"
		}
	}
}

#
#  Authentication of FreeRADIUS towards EZECLOUD: shared service token in an
#  HTTP header (DEPLOYMENT_ARCHITECTURE.md §4.2; mods-available/rest).
#  control:REST-HTTP-Header attributes are consumed by the next rlm_rest
#  call, so this policy runs before EVERY rest call.
#
#  $ENV{INTERNAL_API_TOKEN} is substituted when the configuration is read.
#  The string is still an xlat at run time, so the token must not contain
#  '%', '"' or '\' (documented in infra/freeradius/README.md).
#
ecloud_rest_headers {
	update control {
		&REST-HTTP-Header += "X-Internal-Token: $ENV{INTERNAL_API_TOKEN}"
		&REST-HTTP-Header += "Accept: application/json"
	}
}

#
#  Post-auth: strip credentials from the request list before it is posted to
#  /internal/aaa/post-auth and carry the outcome over (reply attributes are
#  not serialised by rlm_rest, so Class/Reply-Message are copied as strings).
#
ecloud_post_auth_context {
	update request {
		&ECLOUD-Decision := "%{control:ECLOUD-Decision}"
		&User-Password !* ANY
		&CHAP-Password !* ANY
		&CHAP-Challenge !* ANY
		&MS-CHAP-Response !* ANY
		&MS-CHAP2-Response !* ANY
		&MS-CHAP-Challenge !* ANY
		&EAP-Message !* ANY
	}
	if (&reply:Class) {
		update request {
			&ECLOUD-Reply-Class := "%{reply:Class}"
		}
	}
	if (&reply:Reply-Message) {
		update request {
			&ECLOUD-Reply-Message := "%{reply:Reply-Message}"
		}
	}
}
