# ECLOUD environment template (D-033: never commit real secrets).
# Copy to `.env` for local development; `.env` and `.env.*` are gitignored.
# Every value below is a placeholder or a DEV-ONLY default. Production values are injected
# by the deployment (Compose secrets / environment), never stored in git.
# Variable names are defined and validated in packages/shared/src/config.ts.

# ---- runtime ---------------------------------------------------------------
NODE_ENV=development                 # development | test | production
LOG_LEVEL=debug                      # fatal | error | warn | info | debug | trace | silent

# ---- listeners -------------------------------------------------------------
API_PORT=3000                        # public REST API (/api/v1)
INTERNAL_PORT=3001                   # internal listener (FreeRADIUS rlm_rest -> core), never public
PORTAL_PORT=3002                     # captive portal server

# ---- PostgreSQL 16 (dev stack: infra/compose/docker-compose.dev.yml) -------
# ecloud_app: NOSUPERUSER role subject to Row-Level Security (api/portal)
DATABASE_URL=postgres://ecloud_app:ecloud_dev_password@127.0.0.1:5432/ecloud
# ecloud_platform: BYPASSRLS role for the worker and migrations
DATABASE_URL_PLATFORM=postgres://ecloud_platform:ecloud_dev_password@127.0.0.1:5432/ecloud

# ---- Redis 7 (BullMQ queues + cache) ---------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---- admin sessions --------------------------------------------------------
# Production uses a `__Host-` prefixed cookie (requires HTTPS); dev uses a plain name.
SESSION_COOKIE_NAME=ecloud_sid
SESSION_TTL_SECONDS=43200            # absolute session lifetime (12 h)

# ---- internal API (FreeRADIUS -> core) -------------------------------------
# DEV ONLY placeholder. Production REQUIRES a random value of at least 32 characters.
INTERNAL_API_TOKEN=ecloud_dev_internal_token_change_me

# ---- API key material (apps/api/src/config.ts) -----------------------------
# DEV ONLY placeholders; production refuses them and requires >= 32 random characters each.
MFA_ENCRYPTION_KEY=ecloud_dev_mfa_encryption_key_change_me     # seals TOTP secrets (AES-256-GCM)
DATA_ENCRYPTION_KEY=ecloud_dev_data_encryption_key_change_me   # seals NAS/UAM secret_ref values
VOUCHER_PEPPER=ecloud_dev_voucher_pepper_change_me             # HMAC pepper of voucher codes
# SESSION_COOKIE_SECURE=false       # production: must not be false; SESSION_COOKIE_NAME must start with __Host-
# TRUST_PROXY_HOPS=0                # 1 behind native Caddy

# ---- secrets as files (P10-A; SECURITY_ARCHITECTURE.md §6.11 / §9) ----------
# Every secret-bearing variable above may instead be given as <NAME>_FILE=<path>, e.g.
#   INTERNAL_API_TOKEN_FILE=/run/secrets/internal_api_token
# (DATABASE_URL, DATABASE_URL_PLATFORM, REDIS_URL, INTERNAL_API_TOKEN, S3_ACCESS_KEY_ID,
#  S3_SECRET_ACCESS_KEY, MFA_ENCRYPTION_KEY, DATA_ENCRYPTION_KEY, VOUCHER_PEPPER,
#  PORTAL_STATE_SECRET). Setting both forms is an error. Generate/validate per-environment
#  files with scripts/secrets/ (docs/SECRETS_MANAGEMENT.md); they are never committed.

# ---- password hashing (argon2id, t=2, p=1) ---------------------------------
ARGON2_MEMORY_KIB=19456

# ---- public origins (D-029) ------------------------------------------------
PUBLIC_ADMIN_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
PUBLIC_PORTAL_ORIGIN=http://localhost:3002

# ---- captive portal (apps/portal, Phase 6) ----------------------------------
# HMAC key for flow/CSRF tokens. DEV ONLY placeholder; production refuses it (>= 32 chars).
PORTAL_STATE_SECRET=ecloud_dev_portal_state_secret_change_me
# api internal listener the portal calls (/internal/portal/*); default http://127.0.0.1:$INTERNAL_PORT
PORTAL_INTERNAL_API_URL=http://127.0.0.1:3001
# PORTAL_API_TIMEOUT_MS=5000
# PORTAL_COOKIE_SECURE=false        # true in production (HTTPS: __Host- cookie + HSTS)
# PORTAL_TRUST_PROXY_HOPS=0         # MUST be 1 behind native Caddy (per-IP limits depend on it)

# ---- object storage (D-026: local on the pilot, S3-compatible in production) ----
STORAGE_DRIVER=local                 # local | s3
STORAGE_LOCAL_PATH=./var/storage
# Production only: the local driver is rejected unless explicitly allowed (D-026: non-critical
# branding/dev assets only, never the sole copy of data that must survive the VPS).
STORAGE_LOCAL_ALLOW_PRODUCTION=false
# In production S3_ENDPOINT must be https://
# Required only when STORAGE_DRIVER=s3 (names only; no real values in git)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- RADIUS (M6; see DEPLOYMENT_ARCHITECTURE.md, infra/freeradius/README.md) ----
RADIUS_BIND_IP=                      # HOST address Compose publishes 1812/1813 on in production:
                                     # tunnel address only (D-032); empty = not bound
RADIUS_PUBLIC_BIND_IP=               # empty = never published publicly
RADIUS_COA_PORT=3799
RADIUS_SQL_USER=ecloud_radius        # INSERT-only role on radius.radacct_raw (packages/db)
RADIUS_SQL_PASSWORD_FILE=            # production: path to a secret file, never the secret itself
RADIUS_DICTIONARY_DIR=
# Secrets read by the freeradius container. Production uses the *_FILE forms
# (Compose secrets -> /run/secrets/<name>); the plain forms are DEV ONLY placeholders.
RADIUS_STATUS_SECRET=ecloud_dev_status_secret        # Status-Server client on 127.0.0.1:18121 (healthcheck)
RADIUS_STATUS_SECRET_FILE=                           # production alternative
RADIUS_DEV_CLIENT_SECRET=ecloud_dev_radius_secret    # the single dev NAS client; production clients are rendered by ECLOUD

# ---- test-only (integration tests skip cleanly when unset) -----------------
# ECLOUD_TEST_DATABASE_URL=postgres://ecloud_platform:ecloud_dev_password@127.0.0.1:5432/ecloud_test
# ECLOUD_TEST_REDIS_URL=redis://127.0.0.1:6379/1

# ---- dev stack only (docker-compose.dev.yml reads these; all DEV ONLY) -----
POSTGRES_DB=ecloud
POSTGRES_USER=ecloud
POSTGRES_PASSWORD=ecloud_dev_password
ECLOUD_APP_PASSWORD=ecloud_dev_password
ECLOUD_PLATFORM_PASSWORD=ecloud_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
# freeradius service (infra/freeradius). RADIUS_SQL_PASSWORD is the DEV plain-text
# form of RADIUS_SQL_PASSWORD_FILE; ECLOUD_INTERNAL_URL is where the container reaches
# the api internal listener (INTERNAL_PORT) running on the developer host.
RADIUS_SQL_PASSWORD=ecloud_dev_password
RADIUS_LISTEN_IP=0.0.0.0             # address INSIDE the container (Compose publishes 127.0.0.1 only)
RADIUS_DEV_CLIENT_CIDR=172.16.0.0/12 # source range accepted as the dev NAS client (Docker bridge networks)
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
ECLOUD_INTERNAL_URL=http://host.docker.internal:3001
